# ============================================
# Base de Datos MySQL
# ============================================
MYSQL_DATABASE=backend_bank
MYSQL_USER=backend_user
MYSQL_PASSWORD=backend_pass
MYSQL_ROOT_PASSWORD=root_pass
MYSQL_PORT=3306

# ============================================
# Spring Boot & Backend
# ============================================
# Puertos
SERVER_PORT=8080

# Seguridad (cambiar en producción)
SECURITY_USER=admin
SECURITY_PASSWORD=admin123

# ============================================
# Java/JVM Options (Docker)
# ============================================
JAVA_OPTS=-Xmx512m -Xms256m

# ============================================
# Notas:
# - MYSQL_USER debe ser "backend_user" (no root)
# - En producción, cambiar todas las contraseñas
# - MYSQL_HOST=localhost para local, "mysql" para Docker
# ============================================
